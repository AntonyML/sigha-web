# =============================================================
# Configuración de Playwright (e2e)
# Copia este archivo como `.env.e2e` y completa las credenciales.
# `.env.e2e` está en `.gitignore`, por lo que NO se sube al repo.
# =============================================================

# Credenciales de un usuario con rol admin / super admin
# para poder acceder a los módulos protegidos.
E2E_ADMIN_EMAIL=TU_EMAIL_ADMIN@ejemplo.com
E2E_ADMIN_PASSWORD=TU_CONTRASENA

# OPCIÓN A — Cuenta SIN 2FA:
#   El global-setup entra directo con estas credenciales. No se pide nada más.
#
# OPCIÓN B — Cuenta CON 2FA:
#   1. Deja en blanco E2E_2FA_CODE.
#   2. Al correr los tests, la terminal te pedirá que digites el código vigente
#      de tu app autenticadora (6 dígitos). El flujo lo espera y completa el login.
#   Alternativa automática (no interactiva): pon aquí el código vigente; expira,
#   así que sirve solo para la ejecución inmediata.
E2E_2FA_CODE=

# URL base de la API NestJS (por defecto http://localhost:3000)
E2E_API_URL=http://localhost:3000

# URL base del frontend Next.js
E2E_WEB_URL=http://localhost:3001

# Habilita la prueba destructiva de borrado.
# La prueba crea su propio expediente vía API y luego lo borra desde la UI,
# por lo que no toca datos reales. Con "0" (o sin variable) esa prueba se omite.
E2E_RUN_DELETE=0

# Modo de navegador: "true" abre una ventana con GUI (headed), "false"/vacío
# corre sin interfaz (headless). También puede pasarse con --headed/--headless.
E2E_HEADED=false
