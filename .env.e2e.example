# =============================================================
# Configuración de Playwright (e2e)
# Copia este archivo como `.env.e2e` y completa las credenciales.
# `.env.e2e` está en `.gitignore`, por lo que NO se sube al repo.
# =============================================================

# Credenciales de un usuario con rol admin / super admin
# para poder acceder al módulo de expedientes (/virtualFiles).
# OJO: si la app exige 2FA, el usuario debe tener el 2FA habilitado.
E2E_ADMIN_EMAIL=antony.mongelopez@ucr.ac.cr
E2E_ADMIN_PASSWORD=antony.mongelopez@ucr.ac.cr

# URL base de la API NestJS (por defecto http://localhost:3000)
E2E_API_URL=http://localhost:3000

# Habilita la prueba destructiva de borrado.
# La prueba crea su propio expediente vía API y luego lo borra desde la UI,
# por lo que no toca datos reales. Con "0" (o sin variable) esa prueba se omite.
E2E_RUN_DELETE=0