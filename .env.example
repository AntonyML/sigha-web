# En desarrollo, usa el proxy del mismo origen; en Pages apunta al API externo al compilar.
NEXT_PUBLIC_API_URL=/api/backend
# Destino del proxy de desarrollo de `next dev`.
BACKEND_API_URL=http://localhost:3000

# Entorno: development | production
NEXT_PUBLIC_APP_ENV=development

# Origen público del sitio (canonical, sitemap y robots). Sin barra final.
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# 2FA — true en producción, false para desarrollo sin 2FA
NEXT_PUBLIC_ENABLE_2FA=false

# Dummy 2FA code para dev (ignorado si NEXT_PUBLIC_ENABLE_2FA=true)
NEXT_PUBLIC_2FA_DUMMY_CODE=000000
