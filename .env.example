# El navegador llama al proxy de Next.js; el destino real solo vive en el servidor.
NEXT_PUBLIC_API_URL=/api/backend
BACKEND_API_URL=http://localhost:3000

# Entorno: development | production
NEXT_PUBLIC_APP_ENV=development

# 2FA — true en producción, false para desarrollo sin 2FA
NEXT_PUBLIC_ENABLE_2FA=false

# Dummy 2FA code para dev (ignorado si NEXT_PUBLIC_ENABLE_2FA=true)
NEXT_PUBLIC_2FA_DUMMY_CODE=000000
